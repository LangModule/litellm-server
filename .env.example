# Copy this file to .env and fill in the empty values.
# .env is ignored by Git. Never commit real secrets here.
# Generate each secret separately; do not reuse passwords or keys.

# --- LiteLLM ---

# LiteLLM master key: authorizes management and API access.
# Generate: openssl rand -hex 32 | sed 's/^/sk-/'
# Paste the output below. Generate the salt key separately.
LITELLM_MASTER_KEY=

# LiteLLM salt key: encrypts provider credentials stored in the database.
# Generate: openssl rand -hex 32
# Paste the output below. Keep this key stable and backed up with the database.
LITELLM_SALT_KEY=

# --- PostgreSQL ---

# Database username and name, initialized when the data volume is first created.
POSTGRES_USER=litellm
POSTGRES_DB=litellm

# Generate a URL-safe password: openssl rand -hex 32
# Changing this value does not change the password in an existing database.
POSTGRES_PASSWORD=

# Connection URL: postgresql://<user>:<password>@db:5432/<database>
# Percent-encode special characters in the username, password, and database name.
# Use db:5432 inside Compose, not localhost. Match the PostgreSQL values above.
# Update this URL whenever the actual database credentials change.
DATABASE_URL=

# --- Redis ---

# Password shared by the Redis server and LiteLLM.
# Generate: openssl rand -hex 32
# Compose sets REDIS_HOST=redis and REDIS_PORT=6379 for LiteLLM.
REDIS_PASSWORD=

# --- Microsoft Entra SSO ---

# App registrations > LiteLLM_DEV > Overview > Application (client) ID.
MICROSOFT_CLIENT_ID=

# App registrations > LiteLLM_DEV > Overview > Directory (tenant) ID.
MICROSOFT_TENANT=

# Certificates & secrets > Client secrets: copy the secret Value, not its Secret ID.
# Record its expiration date and replace it before it expires.
MICROSOFT_CLIENT_SECRET=

# --- Public URL ---

# Browser-facing base URL; omit the trailing slash, /ui, and /sso/callback.
# For remote testing, replace localhost with your ngrok HTTPS URL.
# Register <PROXY_BASE_URL>/sso/callback as a Web redirect URI in Entra.
# Open <PROXY_BASE_URL>/ui to sign in.
PROXY_BASE_URL=http://localhost:4000
